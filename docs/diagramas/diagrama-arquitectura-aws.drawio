<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram id="aws-architecture" name="Arquitectura AWS (propuesta)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Arquitectura propuesta para despliegue en AWS &#8212; ECS Express Mode" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Documentado en infra/aws/ (provision.sh + trust policies). No ejecutado en esta entrega por falta de credenciales AWS &#8212; queda listo para correr en cuanto exista la cuenta." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="42" width="1000" height="24" as="geometry" />
        </mxCell>

        <!-- DEVELOPER -->
        <mxCell id="dev" value="Desarrollador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- GITHUB CONTAINER -->
        <mxCell id="github" value="GitHub &#8212; festem200/davKata-CoreEcommerce" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#24292e;strokeWidth=2;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="170" width="280" height="500" as="geometry" />
        </mxCell>
        <mxCell id="gh_integration" value="Rama: integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ci_yml" value="ci.yml&lt;br&gt;build imagen &#8594; push a ECR&lt;br&gt;(int-&lt;sha&gt;, int-latest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292e;fontColor=#ffffff;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="280" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gh_main" value="Rama: main&lt;br&gt;(tras PR integration &#8594; laboratory &#8594; main)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="deploy_yml" value="deploy-prod.yml&lt;br&gt;retag prod-&lt;sha&gt; (no reconstruye)&lt;br&gt;&#8594; despliega/actualiza ECS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292e;fontColor=#ffffff;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oidc" value="GitHub OIDC Provider&lt;br&gt;token.actions.githubusercontent.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292e;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- AWS CLOUD CONTAINER -->
        <mxCell id="aws_cloud" value="AWS Cloud &#8212; cuenta personal (Free Plan)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=none;strokeColor=#FF9900;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;fontColor=#B25000;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="1080" height="900" as="geometry" />
        </mxCell>

        <mxCell id="iam_role" value="IAM Role: github-actions-ecs-role&lt;br&gt;trust: refs/heads/main, refs/heads/integration&lt;br&gt;(AssumeRoleWithWebIdentity vía OIDC &#8212; sin llaves de larga duración)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;fontColor=#ffffff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ecr" value="ECR &#8212; repositorio: core-ecommerce&lt;br&gt;tags: int-&lt;sha&gt;, int-latest, prod-&lt;sha&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;fontColor=#ffffff;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- VPC CONTAINER -->
        <mxCell id="vpc" value="VPC (gestionada por ECS Express Mode)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;fontColor=#5A2D9C;" vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="1000" height="560" as="geometry" />
        </mxCell>

        <mxCell id="public_subnet" value="Subnet pública" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="410" width="800" height="220" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="Application Load Balancer&lt;br&gt;HTTPS/SSL (compartido entre servicios)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;fontColor=#ffffff;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="470" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ecs_service" value="ECS Express Mode Service&lt;br&gt;core-ecommerce-prod&lt;br&gt;Fargate 0.25 vCPU / 0.5 GB &#183; 1-2 tareas (autoescalado)&lt;br&gt;containerPort 8080 &#183; health check: /health&lt;br&gt;rol de ejecución: ecsTaskExecutionRole" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;fontColor=#ffffff;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="450" width="430" height="130" as="geometry" />
        </mxCell>

        <mxCell id="private_subnet" value="Subnet privada" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="650" width="800" height="230" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="RDS PostgreSQL db.t4g.micro (opcional)&lt;br&gt;no accesible públicamente&lt;br&gt;PERSISTENCE_DRIVER=postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#527FFF;fontColor=#ffffff;strokeColor=#2A4FCC;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="700" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rds_note" value="Sin RDS: PERSISTENCE_DRIVER=json corre embebido en el propio contenedor (sin infraestructura adicional)." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="460" y="800" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ecs_infra_role" value="IAM Role: ecsInfrastructureRoleForExpressServices&lt;br&gt;(provisiona ALB + servicio + autoescalado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;fontColor=#ffffff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="700" width="300" height="65" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch" value="CloudWatch Logs&lt;br&gt;(logs de tareas Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="410" width="140" height="90" as="geometry" />
        </mxCell>

        <!-- USER -->
        <mxCell id="user" value="Usuario / Cliente&lt;br&gt;(navegador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1470" y="440" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- FALLBACK -->
        <mxCell id="fallback" value="Alternativa (fallback): AWS Lambda (container image) + AWS Lambda Web Adapter &#8212; $0 always free&lt;br&gt;Misma imagen Docker, sin cambios de código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="1010" width="560" height="70" as="geometry" />
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="legend" value="&lt;b&gt;Por qué ECS Express Mode y no Lambda:&lt;/b&gt; la misma imagen de contenedor corre sin cambios en Fargate, EKS, Cloud Run o Azure Container Apps &#8212; el área de Open Banking destino está migrando a multinube, así que se elige la opción portable. GitHub Actions no usa credenciales de larga duración: asume el rol vía OIDC (AssumeRoleWithWebIdentity), restringido por rama en la trust policy." style="text;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="1010" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <mxCell id="e1" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="dev" target="gh_integration">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="push" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gh_integration" target="ci_yml">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="PR merge" style="html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="gh_integration" target="gh_main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="push a main" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gh_main" target="deploy_yml">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="confía en (trust policy)" style="html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="oidc" target="iam_role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="AssumeRoleWithWebIdentity" style="html=1;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="ci_yml" target="iam_role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="AssumeRoleWithWebIdentity" style="html=1;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="deploy_yml" target="iam_role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="docker push" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ci_yml" target="ecr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="retag prod-&lt;sha&gt;" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="deploy_yml" target="ecr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="crea/actualiza servicio" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="deploy_yml" target="ecs_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="HTTPS" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="user" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="alb" target="ecs_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="pull image" style="html=1;endArrow=block;fontSize=10;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecs_service" target="ecr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="opcional" style="html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="ecs_service" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="logs" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ecs_service" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="provisiona" style="html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="ecs_infra_role" target="ecs_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="alternativa si Express Mode no es viable a tiempo" style="html=1;endArrow=block;fontSize=10;dashed=1;strokeColor=#D79B00;fontColor=#B25000;" edge="1" parent="1" source="ecr" target="fallback">
